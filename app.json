{
  "expo": {
    "name": "Kotaeai",
    "slug": "couple-swipe-app",
    "scheme": "couple-swipe-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.garanapop.coupleswipeapp",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "locales": {
      "ja": "./locales/native/ja.json",
      "en": "./locales/native/en.json",
      "fr": "./locales/native/fr.json",
      "ko": "./locales/native/ko.json",
      "ru": "./locales/native/ru.json",
      "th": "./locales/native/th.json",
      "zh-Hans": "./locales/native/zh-Hans.json",
      "zh-Hant": "./locales/native/zh-Hant.json"
    },
    "android": {
      "package": "com.garanapop.coupleswipeapp",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E06D53",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-localization",
        {
          "supportedLocales": [
            "ja",
            "en",
            "fr",
            "ko",
            "ru",
            "th",
            "zh-Hans",
            "zh-Hant"
          ]
        }
      ],
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#E06D53"
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5EFE7",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "53113b48-89fc-44ec-b0d1-0bdd6fdab884"
      }
    }
  }
}
